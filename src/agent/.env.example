# Azure AI Foundry Project Configuration

# Foundry Project Endpoint (from Azure portal or Foundry portal)
# Example: https://your-foundry-resource.ai.azure.com/api/projects/your-project-name
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project-name

# Model Deployment Name (deployed in your Foundry project)
# Example: gpt-5.1, gpt-4.1, claude-sonnet-4-5, etc.
FOUNDRY_MODEL_DEPLOYMENT_NAME=your-model-deployment-name

# Foundry API Key (from Azure portal or Foundry portal)
# Get this from: Azure AI Foundry portal > Your Project > Keys and Endpoints
FOUNDRY_API_KEY=your-api-key-here

# Optional: Existing persistent agent id in Foundry (to reuse across restarts)
# Leave empty to let runtime resolve/create during migration phases
FOUNDRY_AGENT_ID=

# Optional: local state file used to persist/reuse resolved Foundry agent id
FOUNDRY_AGENT_STATE_FILE=.foundry-agent-state.json

# Runtime backend selection
# - foundry: Azure AI Foundry hosted threads/runs (default)
# - agent-framework: fallback in-process runtime
AGENT_RUNTIME_BACKEND=foundry

# HomeBanking API Configuration
# Base URL for the existing .NET API
BACKEND_API_URL=http://localhost:5091

# Agent Server Configuration
AGENT_PORT=8087

# Logging Configuration
LOG_LEVEL=DEBUG
