# Azure AI Foundry Project Configuration
# Copy this file to .env and fill in your actual values

# Foundry Project Endpoint (from Azure portal or Foundry portal)
# Example: https://your-foundry-resource.ai.azure.com/api/projects/your-project-name
FOUNDRY_PROJECT_ENDPOINT=<your-project-endpoint>

# Model Deployment Name (deployed in your Foundry project)
# Example: gpt-4o, gpt-4.1, etc.
FOUNDRY_MODEL_DEPLOYMENT_NAME=<model-deployment-name>

# HomeBanking API Configuration
# Base URL for the existing .NET API
HOMEBANKING_API_BASE_URL=http://localhost:5091

# Optional: API key for HomeBanking API (if implemented)
# HOMEBANKING_API_KEY=<api-key>

# Agent Server Configuration
AGENT_SERVER_PORT=8087
AGENT_SERVER_HOST=127.0.0.1

# Logging Configuration
LOG_LEVEL=INFO
